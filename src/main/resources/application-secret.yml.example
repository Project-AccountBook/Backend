# Template for application-secret.yml
# 복사 후 실제 값으로 채워서 사용:
#   cp src/main/resources/application-secret.yml.example src/main/resources/application-secret.yml
# 실제 파일은 .gitignore 처리되어 커밋되지 않음.

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/jointliving?useSSL=false&serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true
    username: jointliving
    password: jointliving

  jpa:
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQL8Dialect

  data:
    redis:
      host: localhost
      port: 6379
  cache:
    type: redis
    redis:
      time-to-live: 3600000 # 1시간

  mail:
    password: REPLACE_WITH_RESEND_API_KEY

  security:
    oauth2:
      client:
        registration:
          google:
            client-id: REPLACE_WITH_GOOGLE_CLIENT_ID
            client-secret: REPLACE_WITH_GOOGLE_CLIENT_SECRET
            scope: profile, email
          kakao:
            client-id: REPLACE_WITH_KAKAO_CLIENT_ID
            client-secret: REPLACE_WITH_KAKAO_CLIENT_SECRET
            client-authentication-method: client_secret_post
            authorization-grant-type: authorization_code
            redirect-uri: "{baseUrl}/login/oauth2/code/{registrationId}"
            client-name: Kakao
            scope: profile_nickname, account_email
          naver:
            client-id: REPLACE_WITH_NAVER_CLIENT_ID
            client-secret: REPLACE_WITH_NAVER_CLIENT_SECRET
            redirect-uri: "{baseUrl}/login/oauth2/code/{registrationId}"
            authorization-grant-type: authorization_code
            client-name: Naver
            scope: name, email
        provider:
          kakao:
            authorization-uri: https://kauth.kakao.com/oauth/authorize
            token-uri: https://kauth.kakao.com/oauth/token
            user-info-uri: https://kapi.kakao.com/v2/user/me
            user-name-attribute: id
          naver:
            authorization-uri: https://nid.naver.com/oauth2.0/authorize
            token-uri: https://nid.naver.com/oauth2.0/token
            user-info-uri: https://openapi.naver.com/v1/nid/me
            user-name-attribute: response

app:
  mail:
    from: noreply@moneydiary.cloud
    dev-log-code: true
  admin:
    email: REPLACE_WITH_ADMIN_EMAIL

jwt:
  # 최소 32자 base64 문자열. 예: openssl rand -base64 48
  secret: REPLACE_WITH_JWT_SECRET_MIN_32_CHARS_BASE64

aws:
  s3:
    region: ap-northeast-2
    access-key: REPLACE_WITH_AWS_ACCESS_KEY
    secret-key: REPLACE_WITH_AWS_SECRET_KEY
    bucket: REPLACE_WITH_S3_BUCKET_NAME
  cdn:
    base-url: REPLACE_WITH_CLOUDFRONT_URL
